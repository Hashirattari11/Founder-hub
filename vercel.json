{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && rm -rf node_modules && test -f dist/index.html",
  "outputDirectory": "frontend/dist",
  "functions": {
    "main.py": {
      "runtime": "@vercel/python",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/main.py" },
    { "source": "/health", "destination": "/main.py" },
    { "source": "/((?!assets/|_next/).*)", "destination": "/main.py" }
  ]
}
