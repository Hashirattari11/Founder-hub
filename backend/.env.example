# Backend environment — copy to .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for email notifications (message/connection emails).
# From Supabase Dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Brevo is the single transactional email provider.
BREVO_API_KEY=your-brevo-api-key
# Verified Brevo sender (must be verified in the Brevo dashboard).
EMAIL_FROM_EMAIL="hashirattari73@11839374.brevosend.com"
# Optional: secret Brevo uses to sign webhook delivery events
# (POST <backend>/api/webhooks/brevo).
BREVO_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app
# Server-side key used for AI generation when a user has not connected their own key.
ANTHROPIC_API_KEY=
# 32-byte Fernet key for encrypting stored API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Super Admin bootstrap — the account whose email is auto-promoted to super admin.
# Set to the platform owner's email; the password is only used if the account
# does not exist yet and must be provisioned. NEVER commit real values.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me
