# Frontend environment — copy to .env.local
# Supabase (public/publishable values — safe to commit as Vercel env vars)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app origin (used for auth callbacks)
VITE_APP_URL=https://your-app.vercel.app

# Backend API origin. Required for production (set in Vercel env vars).
# Leave empty in local dev to fall back to http://localhost:8001
VITE_API_URL=
